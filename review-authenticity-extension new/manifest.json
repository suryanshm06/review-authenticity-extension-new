{
  "manifest_version": 3,
  "name": "Review Authenticity Highlighter",
  "version": "1.2.0",
  "description": "Scores Amazon and Flipkart reviews with a local machine-learning model and highlights suspicious ones.",
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.in/*",
        "*://*.amazon.com/*",
        "*://*.flipkart.com/*"
      ],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
